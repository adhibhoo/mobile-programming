<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ATM System</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
            text-align: center;
            margin-top: 50px;
        }

        .atm-box {
            background: white;
            width: 300px;
            margin: auto;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px gray;
        }

        h2 {
            color: #333;
        }

        button {
            width: 200px;
            padding: 10px;
            margin: 10px;
            font-size: 16px;
            cursor: pointer;
            border: none;
            border-radius: 5px;
            background-color: #007bff;
            color: white;
        }

        button:hover {
            background-color: #0056b3;
        }

        #result {
            margin-top: 20px;
            font-size: 18px;
            color: green;
        }
    </style>
</head>

<body>

    <div class="atm-box">
        <h2>Simple ATM System</h2>

        <button onclick="checkBalance()">Check Balance</button>
        <button onclick="depositMoney()">Deposit</button>
        <button onclick="withdrawMoney()">Withdraw</button>

        <p id="result"></p>
    </div>

    <script>

        let balance = 10000;
        let pin = "1234";

        function checkBalance() {
            document.getElementById("result").innerHTML =
                "Current Balance: Rs. " + balance;
        }

        function depositMoney() {

            let userPin = prompt("Enter PIN:");

            if (userPin === pin) {

                let amount = Number(prompt("Enter deposit amount:"));

                if (amount > 0) {
                    balance += amount;

                    document.getElementById("result").innerHTML =
                        "Rs. " + amount + " deposited successfully.<br>New Balance: Rs. " + balance;

                } else {
                    alert("Invalid amount");
                }

            } else {
                alert("Wrong PIN");
            }
        }

        function withdrawMoney() {

            let amount = Number(prompt("Enter withdrawal amount:"));

            if (amount <= balance && amount > 0) {

                balance -= amount;

                document.getElementById("result").innerHTML =
                    "Rs. " + amount + " withdrawn successfully.<br>Remaining Balance: Rs. " + balance;

            } else {
                alert("Insufficient balance or invalid amount");
            }
        }

    </script>

</body>

</html>